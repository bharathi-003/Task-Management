{
  "name": "taskflow-monorepo",
  "version": "1.0.0",
  "description": "TaskFlow - Full Stack MERN Task Management System",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "seed": "node server/utils/seedData.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "start": "node server/server.js"
  },
  "keywords": [
    "mern",
    "task-management",
    "react",
    "express",
    "mongodb",
    "nodejs"
  ],
  "author": "Xplore Intellects Assessment",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
